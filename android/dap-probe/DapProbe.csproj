<Project Sdk="Microsoft.NET.Sdk">

  <!--
    A deliberately plain Debug Adapter Protocol client, with no dependencies
    beyond the .NET base class library, used to prove that the on-device
    debugger can be driven over an adb-forwarded TCP port (Part 4 of
    android/README.md). It is NOT the IDE's client and shares no code with it:
    a problem it finds is a transport-or-debugger problem, not an IDE one.

    Build/run with the SYSTEM .NET SDK (10.0.x); the .NET 11 preview is not
    needed. scripts/run-dap-session.sh runs it for you.
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>DapProbe</RootNamespace>
    <AssemblyName>DapProbe</AssemblyName>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>

</Project>
