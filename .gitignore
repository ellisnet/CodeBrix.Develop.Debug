# Proposed build directory according to README
/build/

# Visual Studio Code
/.vscode/

# Visual Studio (directories)
.vs

# Qt Creator files
CMakeLists.txt.user
*.config
*.creator
*.files
*.includes
*.autosave

# Build artifacts
*.o
*.so
*.a
*.dll
*.pdb
bin/
obj/

# .NET and CoreCLR downloaded by build system
/.dotnet/
/.coreclr/

# cross-build related files
/.tools/

# Container-built debugger binaries ARE committed: they are the exact files the
# nuget/ packaging projects pack, and keeping them here makes the published
# packages reproducible from a checkout. They must be re-included explicitly
# because of the blanket *.so / *.dll rules above.
!/container-build/output/**

# GDB-related
.gdb_history

# Vim swap files
.*.sw?
.sw?

# miscellaneous backup files
*~

# core dumps
core
core.*

# ctags index (used to navigate in source code)
tags

# netcoregdb's command history
.netcoredbg_hist
.claude/settings.local.json

# Android debugging bundle (android/): its self-contained build inputs are
# committed, and the prebuilt arm64 binaries must be re-included past the blanket
# *.so rule above so a fresh clone can run Part 2 without rebuilding first.
# Build outputs written INTO the vendored trees stay ignored (obj/, artifacts/).
!/android/**/prebuilt/
!/android/dbgshim/prebuilt/arm64-v8a/libdbgshim.so
!/android/dbgshim/prebuilt/x86_64/libdbgshim.so
!/android/harness/prebuilt/arm64-v8a/libtrace.so
!/android/harness/prebuilt/x86_64/libtrace.so
/android/dbgshim/build-arm64/
/android/dbgshim/build-x64/
/android/dbgshim/diagnostics-src/artifacts/
# Generated by src/CMakeLists.txt (configure_file) INTO the vendored minipal tree during any build.
/android/netcoredbg/coreclr-deps/native/minipal/minipalconfig.h
!/android/netcoredbg/prebuilt/managed/*.dll
